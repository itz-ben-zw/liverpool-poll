# Required for the PostgreSQL-backed server
DATABASE_URL=postgresql://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
STND_ADMIN_EMAIL=owner@example.com

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Pesepay (optional; without these, orders are recorded as unpaid)
PESEPAY_ENVIRONMENT=sandbox
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
